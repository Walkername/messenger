<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="001-create-profile-table" author="walkername">
        <createTable tableName="profile">
            <column name="id" type="bigint" >
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="account_id" type="bigint" >
                <constraints nullable="false" unique="true" foreignKeyName="fk_profile_account_id" references="account(id)" />
            </column>
            <column name="name" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            alter table profile alter column id add generated by default as identity;
        </sql>

    </changeSet>

    <changeSet id="002-change-name-column" author="walkername">
        <sql>
            alter table profile rename column name to first_name
        </sql>
    </changeSet>

    <changeSet id="003-remove-firstname-nullable-constraint" author="walkername">
        <dropNotNullConstraint tableName="profile" columnName="first_name" />
    </changeSet>

</databaseChangeLog>