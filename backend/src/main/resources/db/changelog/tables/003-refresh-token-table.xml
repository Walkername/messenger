<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="create-refresh-token-minimal" author="your-name">
        <createTable tableName="refresh_token">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE refresh_token
            ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY;
        </sql>

        <addForeignKeyConstraint
                constraintName="fk_refresh_token_account_id"
                baseTableName="refresh_token"
                baseColumnNames="account_id"
                referencedTableName="account"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

        <addUniqueConstraint
                tableName="refresh_token"
                columnNames="account_id, token_hash"
                constraintName="uq_refresh_token_account_token"/>

        <createIndex tableName="refresh_token" indexName="idx_refresh_token_account_id">
            <column name="account_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-add-previous-token-hash-column" author="walkername">
        <addColumn tableName="refresh_token">
            <column name="previous_token_hash" type="VARCHAR">
                <constraints unique="true"/>
            </column>
        </addColumn>

        <addColumn tableName="refresh_token">
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>