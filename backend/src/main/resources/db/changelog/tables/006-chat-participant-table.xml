<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="001-create-chat-participant-table" author="walkername">

        <createTable tableName="chat_participant">
            <column name="id" type="BIGINT" autoIncrement="true" generationType="BY DEFAULT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="chat_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_chat_participant_chat_id" references="chat(id)"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="joined_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

    <changeSet id="002-rename-user_id-column" author="walkername">
        <renameColumn tableName="chat_participant" oldColumnName="user_id" newColumnName="account_id"/>
    </changeSet>

    <changeSet id="003-add-unique-account_id-chat_id" author="walkername">
        <addUniqueConstraint
                tableName="chat_participant"
                columnNames="account_id, chat_id"
                constraintName="uq_account_id_chat_id"/>
    </changeSet>

</databaseChangeLog>